# Base de datos Postgres en Neon (free tier)
# IMPORTANTE: usar la connection string con "-pooler" (no la directa),
# porque cada invocación serverless abre su propia conexión.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require&pgbouncer=true

# Gmail SMTP (App Password de una cuenta con 2-Step Verification activado)
GMAIL_USER=tucorreo@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Email de los novios que recibe las notificaciones de RSVP
OWNER_EMAIL=novios@example.com
